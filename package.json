{
  "name": "deckudb",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "npm run start",
    "start": "node --env-file-if-exists=.env --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
