    "@sentry/nuxt": "10.73.0",
    "ai": "7.0.90",
    "dayjs": "^1.11.20",
    "hls.js": "^1.6.15",
    "lucide-vue-next": "^0.544.0",
    "mbs3": "^0.3.1",
    "mongodb": "^6.3.0",
    "normalize.css": "8.0.1",
    "nuxt": "^4.0.0",
    "protobufjs": "^7.5.6",
    "unstorage": "^1.17.5",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0",
    "winston": "^3.18.3",
