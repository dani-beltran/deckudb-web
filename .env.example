NUXT_PORT=3000
# The Sentry DSN is intentionally public so the browser SDK can send telemetry.
# Leave it empty to disable Sentry without changing the build.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Opt in to sending DeckuBot prompts and responses to Sentry. Defaults to false.
NUXT_SENTRY_RECORD_CHAT_CONTENT=false

NUXT_MONGODB_URI=mongodb://localhost:27017/decku
NUXT_MONGODB_DATABASE=decku
NUXT_CLAUDE_API_KEY=your_claude_api_key_here
NUXT_CLAUDE_AI_MODEL=claude-haiku-4-5-20251001
NUXT_SESSION_SECRET=your_current_secret_here,optional_old_secret_for_rotation
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=replace_with_a_long_random_password
NUXT_DAYS_BETWEEN_SCRAPES=180
NUXT_FIRECRAWL_API_KEY=your_firecrawl_api_key_here
NUXT_JOB_TIMEOUT_MINUTES=10
NUXT_JOB_MAX_ATTEMPTS=3
NUXT_WORKER_POLL_INTERVAL_MS=10000
NUXT_WORKER_POLL_JITTER_MS=1000
NUXT_WORKER_REQUEUE_SWEEP_MS=60000
NUXT_SESSION_MAX_AGE_MS=3600000
NUXT_LOGIN_RATE_LIMIT_ENABLED=true
NUXT_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
NUXT_LOGIN_RATE_LIMIT_WINDOW_MS=900000
NUXT_LOGIN_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
NUXT_CHAT_RATE_LIMIT_ENABLED=true
NUXT_CHAT_RATE_LIMIT_MAX_REQUESTS=10
NUXT_CHAT_RATE_LIMIT_WINDOW_MS=60000
NUXT_WORKER_ENABLED=false

# Optional build-only settings for release creation and source-map uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
