NODE_ENV=test
PORT=3000
MONGODB_URI=mongodb://localhost:27017/decku
MONGODB_DATABASE=decku
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_AI_MODEL=claude-haiku-4-5-20251001
SESSION_SECRET=your_current_secret_here,optional_old_secret_for_rotation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password-for-tests
DAYS_BETWEEN_SCRAPES=180
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
JOB_TIMEOUT_MINUTES=10
JOB_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_MS=10000
WORKER_POLL_JITTER_MS=1000
WORKER_REQUEUE_SWEEP_MS=60000
WORKER_IDLE_LOG_EVERY=6
SESSION_MAX_AGE_MS=3600000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
LOGIN_RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
WORKER_ENABLED=false
E2E_TESTS_DEBUG=false
